# Apache config for Hostinger (or any Apache/LiteSpeed shared host).
# Pure static site - no PHP, no build step. Supabase is the entire backend.

RewriteEngine On

# Force https://www.stowflex.com (matches every canonical tag on the site).
# Update the domain here if it's ever different from stowflex.com.
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} !^www\.stowflex\.com$ [NC]
RewriteRule ^ https://www.stowflex.com%{REQUEST_URI} [R=301,L]

# /index.html -> /
RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
RewriteRule ^ /? [R=301,L]

# Any other /page.html -> /page (canonical, no .html in the address bar)
RewriteCond %{THE_REQUEST} \s/+([^.\s]+)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# Every blog post - old or new - is one page (blog/post.html) that renders
# the matching Supabase post client-side. No per-slug file needed here ever;
# publishing/deleting in /admin does not require touching this file.
RewriteRule ^blog/(?!post(?:\.html)?/?$)([^/]+)/?$ /blog/post.html [L]

# Clean URLs: /about serves about.html, /admin/ serves admin/index.html
# (directory requests are handled by Apache's own DirectoryIndex already).
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.*)$ $1.html [L]

# Security headers
<IfModule mod_headers.c>
  Header always set X-Frame-Options "DENY"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), camera=(), microphone=()"
</IfModule>

# Caching
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.(webp|png|jpe?g|svg|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.css$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.js$">
    Header set Cache-Control "public, max-age=3600"
  </FilesMatch>
</IfModule>

# Custom 404 page
ErrorDocument 404 /404.html
